# Opencode — paid-tier LLM access over static key (free tier is app-bound and
# refuses direct API calls: "free tier can only be used in OpenCode")
OPENCODE_API_KEY=oc-...

# Provider selection: zen | openrouter | nim | groq (per-provider static keys;
# server-side plan/entitlement gates cannot be overridden locally — switch, don't spoof)
# LLM_PROVIDER=zen
# OPENROUTER_API_KEY=sk-or-v1-...
# NVIDIA_NIM_API_KEY=nvapi-...   (free at build.nvidia.com; verified API-accessible free tier)
# GROQ_API_KEY=gsk_...           (free tier at console.groq.com)
# OPENROUTER_REFERER=https://example.com  (optional, attribution only)
# OPENROUTER_TITLE=motor-deepagent        (optional, attribution only)

# LLM model selection — overridable per subsystem.
# Run /model in the CLI to list all Opencode Zen models live and switch.
# LLM_MODEL=deepseek-v4-flash-free

# Model catalogue cache (seconds) + fetch timeout for GET <LLM_BASE_URL>/models
# ZEN_MODELS_TTL_SECONDS=3600
# ZEN_MODELS_TIMEOUT_SECONDS=15

# Active motor project folder (workspace/projects/<slug>/). Switch with
# /project use <slug>; legacy spec-file override still works via MOTOR_SPEC.
# MOTOR_PROJECT=my_motor
# MOTOR_SPEC=workspace/projects/my_motor/spec.json

# Full filesystem access is on (absolute paths allowed; project-relative
# paths preferred). Optional root hint for tooling (informational only):
# MOTOR_FS_ROOT=

# Deleting files ALWAYS requires human approval via the delete_file tool.
# Set to 0 only for fully headless runs where deletions are pre-approved
# by the operator (still logged). Default: 1 (approval required).
# DELETE_REQUIRE_APPROVAL=1

# Experiment ledger override (default: active project's workspace/projects/<slug>/ledger.jsonl)
# MOTOR_LEDGER_DIR=

# Motor-CAD execution guards
# MOTORCAD_MAX_SOLVES=200
# MOTORCAD_MAX_CONSECUTIVE_FAILURES=8
# MOTORCAD_REQUIRE_APPROVAL=0  (set 1 to approve every script run in-terminal)

# LangSmith — optional tracing + Studio visualization
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=synrm-agent

# Tavily — web search for agents
TAVILY_API_KEY=tvly-...

# Motor-CAD (optional, for FEA optimization)
# MOTORCAD_EXE=C:\Ansys_Motor-CAD\2025_1_1\Motor-CAD_2025_1_1.exe

# LangGraph step ceiling — unset by default so the framework default governs.
# Set to raise the limit for long optimizations.
# MOTOR_RECURSION_LIMIT=
