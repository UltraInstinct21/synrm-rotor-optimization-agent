# ─── Scratch & Temp Scripts (generated by agent per-session) ─────────────────
workspace/scratch/*
workspace/experiments/*
workspace/research_cache/*
workspace/raw/*
!workspace/scratch/.gitkeep
!workspace/experiments/.gitkeep
!workspace/research_cache/.gitkeep
!workspace/raw/.gitkeep

# ─── Per-project generated scripts & ledgers (never commit) ──────────────────
workspace/projects/*/scratch/
workspace/projects/*/ledger.jsonl

# ─── Agent Runtime Workspace ──────────────────────────────────────────────────
workspace/memory/
workspace/wiki/log.md
workspace/wiki/test_temp_page.md
workspace/wiki/active_tasks.md
workspace/wiki/.obsidian/workspace.json
workspace/wiki/.obsidian/themes/
workspace/wiki/raw/

# ─── CLI Sessions & History ────────────────────────────────────────────────────
.session/
.motor-deepagent/
.input_history
resp_dump.json

# ─── IDE & OS Artifacts ────────────────────────────────────────────────────────
